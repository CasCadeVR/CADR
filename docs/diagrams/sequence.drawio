        <mxCell id="n2" value="Матрица переходов: роль Архитектор/Администратор" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="665" y="570" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Триггер trg_adr_votes_recalc: счёт ≥ порога → «Утверждён»" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="660" y="800" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Счёт &lt; 0 → «Требует пересмотра»; «Устарел» — терминальный статус, сохраняется связь Supersedes на новый ADR" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="640" y="910" width="420" height="54" as="geometry" />
