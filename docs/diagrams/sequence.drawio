        </mxCell>
        <mxCell id="m1" value="Создать ADR (заголовок, шаблон)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="155" y="150" as="sourcePoint" />
            <mxPoint x="375" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="POST /api/v1/adr" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="375" y="195" as="sourcePoint" />
            <mxPoint x="595" y="195" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="create_adr() — номер = max+1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="595" y="240" as="sourcePoint" />
            <mxPoint x="815" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="id, номер записи" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="595" y="285" as="sourcePoint" />
            <mxPoint x="815" y="285" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="Модель ADR («Черновик»)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="595" y="375" as="sourcePoint" />
            <mxPoint x="375" y="375" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="Редактировать разделы" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
