            <mxPoint x="375" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="PATCH /adr/{id}/status" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="375" y="555" as="sourcePoint" />
            <mxPoint x="595" y="555" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m12" value="Голос «за»/«против»" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1035" y="630" as="sourcePoint" />
            <mxPoint x="375" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m13" value="POST /adr/{id}/votes" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
