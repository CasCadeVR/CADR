          </mxGeometry>
        </mxCell>
        <mxCell id="m16" value="Утвердить / Отклонить" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1">
