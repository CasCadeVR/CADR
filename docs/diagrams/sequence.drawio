        <mxCell id="n1" value="Порог = 0 → статус сразу «Утверждён», иначе «Черновик»" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="620" y="300" width="300" height="44" as="geometry" />
