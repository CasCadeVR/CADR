            <mxPoint x="595" y="675" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m14" value="vote_adr() — запрет само-голосования" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" edge="1">
