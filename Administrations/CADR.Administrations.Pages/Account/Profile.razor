@attribute [Route(Routes.Administration.Account.Profile)]
@implements IDisposable

@using CADR.Portal.Contracts.Interfaces
@using CADR.Portal.Components.Enums.Font;
@using CADR.Portal.Components.Controls.Adrs;
@using System.Collections.ObjectModel

@inject IPortalIdentity PortalIdentity
@inject IPortalCadrApiClient ApiClient

<PageTitle>Профиль пользователя</PageTitle>
<Container Size="Containers.Default" ColumnExtraLarge="Columns.Template10" ColumnExtraExtraLarge="Columns.Template8" Padding="4 5">
	<Row FlexDirection="FlexDirections.RowLarge" FlexItemsAlign="FlexAlign.Center" Gutter="5" Padding="* 5">
		<Panel Column="Columns.Template10" ColumnSmall="Columns.Template8" ColumnLarge="Columns.Template6">
			<Image Src="/images/architecture-solution.png" Display="Displays.Block" Loading="ImageLoading.Lazy" Appearances="ImageAppearances.Fluid" Margin="lg:a *" alt="Bootstrap Themes" width="700" height="500" />
		</Panel>
		<Panel ColumnLarge="Columns.Template6">
			<Header Level="1" FontHeader="FontDisplays.Display5" FontStyle="FontStyles.Bold" LineHeight="LineHeights.Minimal" Margin="0 0 0 3">
				@PortalIdentity.Name
			</Header>
			<Paragraph IsLead="true">
				Логин: @PortalIdentity.Login
			</Paragraph>
			<Paragraph IsLead="true">
				Email: @PortalIdentity.Email
			</Paragraph>
		</Panel>
		@if (authorAdrs?.Count != 0)
			{
				<Column>
					<Container Margin="0 0 0 3">
						<Container Padding="4" Size="Containers.Default" Background="ThemeColors.Light"
									RoundedSize="RoundedSizes.Rounded3" Border="1">
							<Header Level="5">Автор этих ADR, </Header>
						</Container>
					</Container>

					<Row Gutter ="3">
						@for (var i = 0; i < authorAdrs!.Count; i++)
						{
							var isLastAndOdd = authorAdrs.Count % 2 == 1 && i == authorAdrs.Count - 1;
							<AdrCard Model="authorAdrs[i]"/>
						}
					</Row>
				</Column>
			}
	</Row>
</Container>

@code {
	private bool isLoaded;
	private ReadOnlyCollection<AdrApiModel>? authorAdrs;
	private readonly CancellationTokenSource cancellationTokenSource = new();

	/// <summary>
	/// Идентификатор организации
	/// </summary>
	[Parameter]
	public Guid OrganizationId { get; set; }

	/// <inheritdoc/>
	protected override async Task OnInitializedAsync()
	{
		await LoadAuthorAdrsAsync();
		await base.OnInitializedAsync();
	}

	private async Task LoadAuthorAdrsAsync()
	{
		var authorAdrsCollection = await ApiClient.AdrGetByAuthorAsync(OrganizationId, PortalIdentity.UserId);
		authorAdrs = new ReadOnlyCollection<AdrApiModel>(authorAdrsCollection.ToList());
	}

    /// <inheritdoc />
    public void Dispose()
    {
        cancellationTokenSource.Cancel();
        cancellationTokenSource.Dispose();
    }
}
