@attribute [Route(Routes.Administration.Organization.TemplateForm)]
@attribute [Route(Routes.Administration.Organization.TemplateFormUpdate)]

@using CADR.Portal.Contracts.Interfaces
@using CADR.Administrations.Pages.Models.Organization

@inherits DisposableComponentBase

@inject IPortalCadrApiClient ApiClient
@inject IPortalIdentity PortalIdentity
@inject NavigationManager NavigationManager

<PageTitle>@pageTitle</PageTitle>

<Container Size="Containers.Default" ColumnExtraLarge="Columns.Template10" ColumnExtraExtraLarge="Columns.Template8" Padding="4 5">
	<CommonEditForm Model="form" Handler="SaveAsync"
					SubmitText="@(TemplateId.HasValue ? "Сохранить" : "Создать")"
					IsDisabledSubmit="@string.IsNullOrWhiteSpace(form.Name)">
		<ChildContent>
			<Header Level="3">@pageTitle</Header>
			<FormRow IsHorizontal="true" Label="Название" LabelAreaWidth="Columns.Template3">
				<InputText @bind-Value="form.Name" class="form-control" id="inputName" type="text" />
				<FormInvalidFeedback>
					<ValidationMessage For="() => form.Name" />
				</FormInvalidFeedback>
			</FormRow>

			@foreach (var entry in form.Sections.Select((section, index) => (section, index)))
			{
				var currentSection = entry.section;
				var currentIndex = entry.index;
				<div class="border rounded-3 p-3 mb-3 position-relative bg-white">
					<button type="button" class="btn-close position-absolute top-0 end-0 m-2"
							@onclick="() => RemoveSection(currentSection)"></button>
					<Paragraph Margin="0 0 0 2">
						<Badge Background="ThemeColors.Secondary" Foreground="ThemeColors.White" RoundedSize="RoundedSizes.Rounded3">
							Секция @(currentIndex + 1)
						</Badge>
					</Paragraph>
					<Row Gutter="0" Gap="2" FlexItemsAlign="FlexAlign.Center">
						<Column Column="Columns.TemplateAuto" FlexContentGrow="FlexGrow.Grow1">
							<InputText @bind-Value="currentSection.Title" class="form-control" placeholder="Заголовок секции" />
						</Column>
						<Column Column="Columns.TemplateAuto">
							<Button IsOutline="true" Color="ThemeColors.Secondary"
									IsDisabled="@(currentIndex == 0)"
									Click="() => MoveSection(currentIndex, currentIndex - 1)">
								<Icon Margin="2 0" IconType="IconTypes.ArrowUp"></Icon>
							</Button>
						</Column>
						<Column Column="Columns.TemplateAuto">
							<Button IsOutline="true" Color="ThemeColors.Secondary"
									IsDisabled="@(currentIndex == form.Sections.Count - 1)"
									Click="() => MoveSection(currentIndex, currentIndex + 1)">
								<Icon Margin="2 0" IconType="IconTypes.ArrowDown"></Icon>
							</Button>
						</Column>
					</Row>
					<InputText @bind-Value="currentSection.Hint" class="form-control mt-2" placeholder="Подсказка" />
					<InputText @bind-Value="currentSection.Placeholder" class="form-control mt-2" placeholder="Placeholder" />
				</div>
			}

			<Button LongWidth="true" Color="ThemeColors.Secondary" IsOutline="true" Margin="0 0 0 3"
					Click="AddSection">
				+ Добавить секцию
			</Button>
		</ChildContent>
	</CommonEditForm>
</Container>

@code {
	private string pageTitle = "Создание шаблона ADR";
	private AdrTemplateFormModel form = new();
	private AdrTemplateApiModel? loadedTemplate;

	/// <summary>
	/// Идентификатор организации
	/// </summary>
	[Parameter]
	public Guid OrganizationId { get; set; }

	/// <summary>
	/// Идентификатор шаблона. Пустое значение — создание
	/// </summary>
	[Parameter]
	public Guid? TemplateId { get; set; }

	/// <inheritdoc />
	protected override async Task OnInitializedAsync()
	{
		if (!TemplateId.HasValue)
		{
			form.Sections.Add(new TemplateSectionEditModel());
		}

		await base.OnInitializedAsync();
	}

	/// <inheritdoc />
	protected override async Task OnParametersSetAsync()
	{
		if (TemplateId.HasValue && loadedTemplate?.Id != TemplateId.Value)
		{
			loadedTemplate = await ApiClient.AdrTemplateGetAsync(TemplateId.Value, TokenSource.Token);
			if (loadedTemplate == null || loadedTemplate.IsBuiltIn)
			{
				NavigationManager.NavigateTo(string.Format(Routes.Administration.Organization.SettingsFormat, OrganizationId));
				return;
			}
			form.Name = loadedTemplate!.Name;
			form.Sections = loadedTemplate.Sections
				.OrderBy(x => x.Position)
				.Select(x => new TemplateSectionEditModel { Title = x.Title, Hint = x.Hint, Placeholder = x.Placeholder })
				.ToList();
			pageTitle = $"Редактирование шаблона «{loadedTemplate.Name}»";
		}
		else if (!TemplateId.HasValue && loadedTemplate != null)
		{
			loadedTemplate = null;
			form = new AdrTemplateFormModel();
			form.Sections.Add(new TemplateSectionEditModel());
			pageTitle = "Создание шаблона ADR";
		}

		await base.OnParametersSetAsync();
	}

	/// <summary>
	/// Сохраняет шаблон: создание или обновление
	/// </summary>
	private async Task SaveAsync(CancellationToken cancellationToken)
	{
		if (TemplateId.HasValue && loadedTemplate != null)
		{
			await ApiClient.AdrTemplateUpdateAsync(new UpdateAdrTemplateApiModel
			{
				UserId = PortalIdentity.UserId,
				Id = loadedTemplate.Id,
				Name = form.Name,
				OrganizationId = loadedTemplate.OrganizationId,
				IsBuiltIn = loadedTemplate.IsBuiltIn,
				Sections = form.Sections
					.Select((section, index) => new AdrTemplateSectionApiModel
					{
						TemplateId = loadedTemplate.Id,
						Position = index + 1,
						Title = section.Title,
						Hint = section.Hint,
						Placeholder = section.Placeholder,
					})
					.ToList(),
			}, cancellationToken);
			NavigationManager.NavigateTo(string.Format(Routes.Administration.Organization.SettingsFormat, OrganizationId));
			return;
		}

		await ApiClient.AdrTemplateCreateAsync(new CreateAdrTemplateApiModel
		{
			Name = form.Name,
			OrganizationId = OrganizationId,
			UserId = PortalIdentity.UserId,
			Sections = form.Sections
				.Select((section, index) => new CreateAdrTemplateSectionApiModel
				{
					Position = index + 1,
					Title = section.Title,
					Hint = section.Hint,
					Placeholder = section.Placeholder,
				})
				.ToList(),
		}, cancellationToken);
		NavigationManager.NavigateTo(string.Format(Routes.Administration.Organization.SettingsFormat, OrganizationId));
	}

	private void AddSection()
		=> form.Sections.Add(new TemplateSectionEditModel());

	private void RemoveSection(TemplateSectionEditModel section)
		=> form.Sections.Remove(section);

	private void MoveSection(int fromIndex, int toIndex)
	{
		if (toIndex < 0 || toIndex >= form.Sections.Count)
		{
			return;
		}
		(form.Sections[fromIndex], form.Sections[toIndex]) = (form.Sections[toIndex], form.Sections[fromIndex]);
	}
}
