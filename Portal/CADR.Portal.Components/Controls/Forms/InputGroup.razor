@using CADR.Portal.Components.Infrastructures
@inherits BootstrapComponentBase

<div class="@BaseCssClass" @attributes="@CapturedAttributes">
    @ChildContent
</div>

@code {
    /// <see cref="RenderFragment"/>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <inheritdoc cref="InputGroupSize"/>
    [Parameter]
    public InputGroupSize Size { get; set; } = InputGroupSize.Default;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        InheritCss.Clear();
        InheritCss.Add("input-group");
        Size.TryAddCssValue(InheritCss);
        await base.OnParametersSetAsync();
    }
}
