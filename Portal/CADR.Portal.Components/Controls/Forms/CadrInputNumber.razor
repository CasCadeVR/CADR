@typeparam T
@using System.Diagnostics.CodeAnalysis
@inherits InputNumber<T>

@{
    base.BuildRenderTree(__builder);
}

@code {

    /// <summary>
    /// Сообщение об ошибке при слишком больших числах
    /// </summary>
    /// <remarks>
    /// Актуально для чисел вещественного типа
    /// </remarks>
    [Parameter]
    public string InvalidInputSizeError { get; set; } = "Введите корректное число";

    /// <inheritdoc />
    protected override bool TryParseValueFromString(string? value, [MaybeNullWhen(false)] out T result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (value?.TakeWhile(x => x is not ',' and not '.').Count() > 10)
        {
            result = default;
            validationErrorMessage = InvalidInputSizeError;
            return false;
        }

        return base.TryParseValueFromString(value, out result, out validationErrorMessage);
    }
}
