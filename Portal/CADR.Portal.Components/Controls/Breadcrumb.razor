@using CADR.Portal.Components.Models
@inherits BootstrapComponentBase

<nav aria-label="breadcrumb" class="@BaseCssClass" @attributes="@CapturedAttributes">
    <ol class="breadcrumb">
        @foreach (var item in Items)
        {
			<li class="breadcrumb-item @(EnableDrop && dropTargetItemId == item.ItemId ? "bg-info-subtle" : string.Empty)"
				ondragover="event.preventDefault();"
				@ondragenter="() => dropTargetItemId = item.ItemId"
				@ondragleave="() => dropTargetItemId = null"
				@ondrop="() => OnItemDrop.InvokeAsync(item)"
				@ondrop:preventDefault>
				<a href="@item.Url">
                    @if (item.IconType.HasValue)
                    {
                        <Icon IconType="@item.IconType.Value" />
                        @if (!string.IsNullOrEmpty(item.Caption))
                        {
                            <text>&nbsp;</text>
                        }
                    }
                    @item.Caption
                </a>
            </li>
        }
        <li class="breadcrumb-item active" aria-current="page">@Caption</li>
        @CaptionAdditional
    </ol>
</nav>

@code {
	private Guid? dropTargetItemId;

	/// <summary>
	/// Заголовок элемента
	/// </summary>
	[Parameter] public string Caption { get; set; } = string.Empty;

	/// <inheritdoc cref="RenderFragment"/>
	[Parameter] public RenderFragment? CaptionAdditional { get; set; }

	[Parameter] public bool EnableDrop { get; set; }

	[Parameter] public EventCallback<LinkedItem> OnItemDrop { get; set; }

	/// <summary>
	/// Список элементов хлебных крошек
	/// </summary>
	[Parameter]
    public IReadOnlyCollection<LinkedItem> Items { get; set; } = Array.Empty<LinkedItem>();
}
