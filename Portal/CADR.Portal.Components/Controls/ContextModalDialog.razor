@typeparam TItem

<div class="modal @modalClass" id="modal@(id.ToString("N"))" tabindex="-1" aria-labelledby="modalLabel@(id.ToString("N"))" style="display:@modalDisplay; overflow-y: auto;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalLabel@(id.ToString("N"))">@Title</h5>
                <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
            </div>
            <div class="modal-body">
                @ModalBody?.Invoke(Context)
            </div>
            <div class="modal-footer">
                @if (ModalFooter != null)
                {
                    @ModalFooter?.Invoke(Context)
                }
                else
                {
                    <button type="button" class="btn btn-primary" @onclick="Close">Закрыть</button>
                }
            </div>
        </div>
    </div>
</div>

@if (showBackdrop)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    private readonly Guid id = Guid.NewGuid();
    private string modalDisplay = "none;";
    private string modalClass = string.Empty;
    private bool showBackdrop;

    /// <summary>
    /// Заголовок диалогового окна
    /// </summary>
    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>
    /// Содержимое диалогового окна
    /// </summary>
    [Parameter]
    public RenderFragment<TItem?>? ModalBody { get; set; }

    /// <summary>
    /// Объект-контекст модального окна
    /// </summary>
    [Parameter]
    public TItem? Context { get; set; }

    /// <summary>
    /// Подвал диалогового окна
    /// </summary>
    [Parameter]
    public RenderFragment<TItem?>? ModalFooter { get; set; }

    /// <summary>
    /// Открывает диалоговое окно
    /// </summary>
    public void Open(TItem context)
    {
        Context = context;

        modalDisplay = "block";
        modalClass = "show";
        showBackdrop = true;

        StateHasChanged();
    }

    /// <summary>
    /// Закрывает диалоговое окно
    /// </summary>
    public void Close()
    {
        modalDisplay = "none";
        modalClass = string.Empty;
        showBackdrop = false;

        StateHasChanged();
    }
}
