@using CADR.Portal.Components.Resources;
@using CADR.Portal.Components.Models;
@using CADR.Api.Client;

<div class="border rounded-3 p-4 h-100">
    <Header Level="2">@Model.Number - @Model.Title</Header>

	<Header Level="5">Создатель: <a href="@string.Format(Routes.Administration.Organization.ProfileFormat, Model.OrganizationId)">@Model.AuthorName (@@@Model.AuthorLogin)</a> </Header>

	@if (adrPath.Count > 0)
	{
		<Row FlexItemsAlign="FlexAlign.Center" Gap="2" Gutter="0">
			<Paragraph Column="Columns.TemplateAuto">Путь: </Paragraph>
			<Breadcrumb Column="Columns.TemplateAuto" Items="adrPath" />
		</Row>
	}

	<Row FlexItemsAlign="FlexAlign.Center" Gap="2" Gutter="0">
		<Header Column="Columns.TemplateAuto"
				FlexContentGrow="FlexGrow.Grow1" Level="5">
			Статус: @Model.Status
		</Header>
		<Header Column="Columns.TemplateAuto" Level="2">@Model.Score</Header>
	</Row>

	<Row FlexItemsAlign="FlexAlign.Center" Gap="2" Gutter="0">
		@if (Model.UpdatedAt != null)
		{
			<Header Column="Columns.TemplateAuto"
				FlexContentGrow="FlexGrow.Grow1"
				Level="6">Последнее обновление: @Model.UpdatedAt
			</Header>
		}

		<Button Padding="2"
			Column="Columns.TemplateAuto"
			AsLink="true"
			Url="@(Routes.Adrs.Organization.AdrDetails)">
			<Icon IconType=IconTypes.Plus></Icon>Подробнее
		</Button>
	</Row>
</div>

@code {
	private IReadOnlyCollection<LinkedItem> adrPath { get; set; } = Array.Empty<LinkedItem>();

	/// <inheritdoc cref="AdrApiModel"/>
	[Parameter]
	public AdrApiModel Model { get; set; } = null!;

	/// <inheritdoc />
	protected override void OnInitialized()
	{
		adrPath = Model.FolderPath.Count > 0
			? Model.FolderPath.Select(x => new LinkedItem()
				{
					Caption = x.Name,
					Url = Routes.Adrs.Organization.Root,
				}).ToList()
			: [new LinkedItem()
			{
				Caption = "/",
				IconType = IconTypes.Home,
				Url = Routes.Adrs.Organization.Root,
			}];

		base.OnInitialized();
	}
}
