@using CADR.Portal.Components.Resources;
@using CADR.Portal.Contracts.Interfaces
@using CADR.Api.Client;

@implements IDisposable

@inject IRecentOrganizationsProvider RecentOrganizaionsProvider

<AuthorizeView>
	<Authorized>
		<nav class="navbar navbar-expand-lg navbar-light bg-light sticky-top border-bottom">
			<div class="container d-flex flex-wrap">
				<a class="navbar-brand" href="@Routes.InvitesDashboard">
					<img src="images/cadr-extend.png" width="85" height="32" class="d-inline-block align-text-top">
				</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="navbarNavDropdown">
					<ul class="navbar-nav">
						<NavMenuItem Caption="Главная" Url="@Routes.InvitesDashboard" />

						@if (isLoaded)
						{
							if (recentOrgs?.Count > 0)
							{
								foreach (var organization in recentOrgs)
								{
									<NavMenuItem Caption="@organization.Name" Url="@string.Format(Routes.Administration.Organization.DashboardFormat, organization.Id)" />
								}
							}
							else
							{
								<NavMenuItem Caption="Пусто" IsDisabled="true" />
							}
						}

					</ul>
					<ul class="navbar-nav ms-auto d-flex">
						@* Надо добавить сюда пункты *@
						<CurrentUser />
					</ul>
				</div>
			</div>
		</nav>
	</Authorized>
	<NotAuthorized>
		<nav class="navbar navbar-expand-lg navbar-light bg-light sticky-top border-bottom">
			<div class="container d-flex flex-wrap justify-content-center">
				<a href="/" class="d-flex align-items-center text-decoration-none">
					<img src="images/cadr.png" width="32" height="32" />
				</a>
			</div>
		</nav>
	</NotAuthorized>
</AuthorizeView>

@code {
	private readonly CancellationTokenSource cancellationTokenSource = new();
	private ICollection<OrganizationApiModel>? recentOrgs;
	private bool isLoaded = false;

	/// <inheritdoc/>
	protected override async Task OnInitializedAsync()
	{
		await LoadItemsAsync();
		await base.OnInitializedAsync();
	}

	private async Task LoadItemsAsync()
	{
		isLoaded = false;
		StateHasChanged();
		recentOrgs = await RecentOrganizaionsProvider.GetOrganizationsAsync(cancellationTokenSource.Token);
		isLoaded = true;
		StateHasChanged();
	}

	private async Task OnNavMenuDropdownOpen()
	{
		recentOrgs = await RecentOrganizaionsProvider.GetOrganizationsAsync(cancellationTokenSource.Token);
		StateHasChanged();
	}

	/// <inheritdoc />
	public void Dispose()
	{
		cancellationTokenSource.Cancel();
		cancellationTokenSource.Dispose();
	}
}
