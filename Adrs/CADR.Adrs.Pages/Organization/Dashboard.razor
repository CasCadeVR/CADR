@attribute [Route(Routes.Administration.Organization.Dashboard)]

@using CADR.Portal.Components.Controls.Adrs
@using CADR.Portal.Contracts.Interfaces
@using AutoMapper
@using Portal.Components.Enums.Font
@using System.Collections.ObjectModel

@inherits DisposableComponentBase
@inject IPortalCadrApiClient ApiClient
@inject IPortalIdentity PortalIdentity
@inject IMapper Mapper

<PageTitle>@currentOrganization?.Name</PageTitle>
@if (isLoaded)
{
	<Container Size="Containers.Default" ColumnExtraExtraLarge="Columns.Template8" Padding="4 5">
		<Row FlexItemsAlign="FlexAlign.Center" Gap="2" Gutter="0">
			<Paragraph FlexContentGrow="FlexGrow.Grow1" Column="Columns.TemplateAuto" FontSize="FontSizes.Size2">
				@currentOrganization?.Name
			</Paragraph>

			@if (currentOrganization?.RequestingUserRole is UserRoleApi.Admin or UserRoleApi.Architect)
			{
				<Button Padding="2" Column="Columns.TemplateAuto" AsLink="true"
					Color="ThemeColors.Success"
					Url="@string.Format(Routes.Adrs.Organization.AdrForm, OrganizationId)">
					<Icon IconType=IconTypes.Plus></Icon> Создать ADR
				</Button>
			}

			<Button Padding="2" Column="Columns.TemplateAuto" AsLink="true"
					Url="@string.Format(Routes.Adrs.Organization.Root, OrganizationId)">
				<Icon IconType=IconTypes.Folder></Icon> Все ADR организации
			</Button>
		</Row>

		@if (recentAdrs?.Count > 0)
		{
			<Column>
				<Container Margin="0 0 0 3">
					<Container Padding="4" Size="Containers.Default" Background="ThemeColors.Light"
						RoundedSize="RoundedSizes.Rounded3" Border="1">
						<Header Level="5">Последние изменения ADR</Header>
					</Container>
				</Container>

				<Row Gutter ="3">
					@for (var i = 0; i < recentAdrs!.Count; i++)
					{
						<AdrCard Model="recentAdrs[i]"/>
					}
				</Row>
			</Column>
		}
	</Container>
}

@code {
	private bool isLoaded;
	private ReadOnlyCollection<AdrApiModel>? recentAdrs;
	private OrganizationApiModel? currentOrganization;

	/// <summary>
	/// Идентификатор организации
	/// </summary>
	[Parameter]
	public Guid OrganizationId { get; set; }

	/// <summary>
	/// Страница списка ADR
	/// </summary>
	[Parameter]
	public int RecentAdrsPage { get; set; } = 1;

	/// <summary>
	/// Размер страницы списка ADR
	/// </summary>
	[Parameter]
	public int RecentAdrsSize { get; set; } = 10;

	/// <inheritdoc />
	protected override async Task OnInitializedAsync()
	{
		isLoaded = false;
		StateHasChanged();
		await LoadOrganizationAsync();
		if (currentOrganization != null)
		{
			await LoadRecentAdrsAsync();
		}
		isLoaded = true;
		StateHasChanged();
		await base.OnInitializedAsync();
	}

	private async Task LoadOrganizationAsync()
	{
		currentOrganization = await ApiClient.OrganizationGetByIdAsync(OrganizationId, TokenSource.Token);
	}

	private async Task LoadRecentAdrsAsync()
	{
		var recentAdrsCollection = await ApiClient.AdrGetRecentAsync(currentOrganization!.Id, RecentAdrsSize);
		recentAdrs = new ReadOnlyCollection<AdrApiModel>(recentAdrsCollection.ToList());
	}
}
