@attribute [Route(Routes.Adrs.Organization.List)]
@attribute [Route(Routes.Adrs.Organization.ListWithFolder)]

@using CADR.Portal.Components.Models
@using CADR.Portal.Contracts.Interfaces
@using System.Net

@inherits DisposableComponentBase
@inject IPortalCadrApiClient ApiClient
@inject NavigationManager NavigationManager

<PageTitle>@currentFolderCaption</PageTitle>

@if (isLoaded)
{
	<Container Size="Containers.Default" ColumnExtraLarge="Columns.Template10" ColumnExtraExtraLarge="Columns.Template8" Padding="4 5">
		@if (errorMessage != null)
		{
			<Alert Color="ThemeColors.Danger" Header="Ошибка">
				<BodyContent>
					<Paragraph>@errorMessage</Paragraph>
				</BodyContent>
			</Alert>
		}
		else
		{
			<Breadcrumb Items="breadcrumbItems" Caption="@currentFolderCaption" Margin="0 0 0 3"/>

			<FormPillsToolBar>
				<PillsContent>
					<PillItem IsActive="@(!isFiltersView)" Url="@GetViewUrl(false)">
						<Icon IconType="IconTypes.Folder" /> Содержимое папки
					</PillItem>
					<PillItem IsActive="@(isFiltersView)" Url="@GetViewUrl(true)">
						<Icon IconType="IconTypes.MagnifyingGlass" /> ADR по фильтрам
					</PillItem>
				</PillsContent>
			</FormPillsToolBar>

			@if (isFiltersView)
			{
				<FormPillsToolBar>
					<PillsContent>
						<PillItem IsActive="@(activeFilter == AdrsFilter.Open)" Url="@GetFilterUrl(AdrsFilter.Open)">
							Открытые (@GetFilterCount(AdrsFilter.Open))
						</PillItem>
						<PillItem IsActive="@(activeFilter == AdrsFilter.Approved)" Url="@GetFilterUrl(AdrsFilter.Approved)">
							Одобренные (@GetFilterCount(AdrsFilter.Approved))
						</PillItem>
						<PillItem IsActive="@(activeFilter == AdrsFilter.Rejected)" Url="@GetFilterUrl(AdrsFilter.Rejected)">
							Отклонённые (@GetFilterCount(AdrsFilter.Rejected))
						</PillItem>
					</PillsContent>
				</FormPillsToolBar>
			}

			@if (!isFiltersView && subfolders.Count != 0)
			{
				<Table TItem="AdrFolderApiModel" Items="subfolders" HoverRows="true" EmptyMessage="Папок нет" Margin="3 0 0 0">
					<TableHeader>
						<th>Папки</th>
						<th style="width: 10%">ADR</th>
					</TableHeader>
					<RowTemplate Context="folder">
						<td>
							<a href="@string.Format(Routes.Adrs.Organization.ListWithFolderFormat, OrganizationId, folder.Id)">
								<Icon IconType="IconTypes.Folder" /> @folder.Name
							</a>
						</td>
						<td>@GetFolderAdrCount(folder.Id)</td>
					</RowTemplate>
				</Table>
			}

			<Table TItem="AdrApiModel" Items="currentAdrs" HoverRows="true" EmptyMessage="@emptyMessage" Margin="3 0 0 0">
				<TableHeader>
					<th style="width: 5%">№</th>
					<th>Название</th>
					<th style="width: 15%">Статус</th>
					<th style="width: 20%">Автор</th>
					<th style="width: 15%">Обновлено</th>
				</TableHeader>
				<RowTemplate Context="adr">
					<td>@adr.Number</td>
					<td>
						<a href="@string.Format(Routes.Adrs.Organization.AdrDetailsFormat, adr.OrganizationId, adr.Id)">@adr.Title</a>
					</td>
					<td>
						<Badge Background="@GetStatusColor(adr.Status)" Foreground="ThemeColors.White" RoundedSize="RoundedSizes.Rounded3">
							@GetStatusCaption(adr.Status)
						</Badge>
					</td>
					<td>
						<a href="@string.Format(Routes.Administration.Organization.UserProfileFormat, adr.OrganizationId, adr.AuthorId)">@adr.AuthorName</a>
					</td>
					<td>@adr.UpdatedAt?.LocalDateTime.ToString("dd.MM.yyyy")</td>
				</RowTemplate>
			</Table>
		}
	</Container>
}
else
{
	<Container Size="Containers.Default" ColumnExtraLarge="Columns.Template10" ColumnExtraExtraLarge="Columns.Template8" Padding="4 5">
		<Paragraph TextAlignment="TextAlignments.Center" Padding="5">
			<Spinner />
		</Paragraph>
	</Container>
}

@code {
	private bool isLoaded;
	private string? errorMessage;
	private Guid loadedOrganizationId;
	private (Guid OrganizationId, Guid FolderId) loadedFolderKey;

	private string currentFolderCaption = string.Empty;
	private IReadOnlyCollection<LinkedItem> breadcrumbItems = [];
	private IReadOnlyCollection<AdrFolderApiModel> subfolders = [];
	private Dictionary<Guid, int> folderAdrCounts = [];
	private IReadOnlyCollection<AdrApiModel> folderAdrs = [];

	private bool isFiltersView;
	private AdrsFilter activeFilter = AdrsFilter.Open;
	private bool filtersLoaded;
	private IReadOnlyCollection<AdrApiModel>? openAdrs;
	private IReadOnlyCollection<AdrApiModel>? approvedAdrs;
	private IReadOnlyCollection<AdrApiModel>? rejectedAdrs;

	/// <summary>
	/// Идентификатор организации
	/// </summary>
	[Parameter]
	public Guid OrganizationId { get; set; }

	/// <summary>
	/// Идентификатор папки. Пустое значение — корневая папка
	/// </summary>
	[Parameter]
	public Guid FolderId { get; set; }

	/// <summary>
	/// Фильтр статусов ADR
	/// </summary>
	private enum AdrsFilter
	{
		Open,
		Approved,
		Rejected,
	}

	/// <summary>
	/// ADR для отображения таблицы
	/// </summary>
	private IReadOnlyCollection<AdrApiModel> currentAdrs
		=> isFiltersView
			? activeFilter switch
			{
				AdrsFilter.Open => openAdrs ?? [],
				AdrsFilter.Approved => approvedAdrs ?? [],
				_ => rejectedAdrs ?? [],
			}
			: folderAdrs;

	/// <summary>
	/// Сообщение для пустой таблицы
	/// </summary>
	private string emptyMessage
		=> isFiltersView
			? "Нет ADR по этому фильтру"
			: FolderId == Guid.Empty
				? "В корневой папке пока нет ADR"
				: "В папке пока нет ADR";

	/// <inheritdoc />
	protected override async Task OnParametersSetAsync()
	{
		if (OrganizationId == Guid.Empty)
		{
			NavigationManager.NavigateTo(Routes.InvitesDashboard);
			return;
		}

		(isFiltersView, activeFilter) = ParseViewQuery(NavigationManager.Uri);

		var folderKey = (OrganizationId, FolderId);
		var needFolderData = folderKey != loadedFolderKey;
		var needFilters = isFiltersView && !filtersLoaded;
		if (!needFolderData && !needFilters)
		{
			return;
		}

		isLoaded = false;
		StateHasChanged();
		try
		{
			if (needFolderData)
			{
				loadedFolderKey = folderKey;
				if (OrganizationId != loadedOrganizationId)
				{
					ResetFilters();
				}
				loadedOrganizationId = OrganizationId;
				await LoadFolderDataAsync();
			}
			if (needFilters)
			{
				await EnsureFiltersLoadedAsync();
			}
			errorMessage = null;
		}
		catch (ApiException<ApiExceptionDetail> exception)
			when (exception.StatusCode == (int)HttpStatusCode.Forbidden
				  || exception.StatusCode == (int)HttpStatusCode.NotFound)
		{
			NavigationManager.NavigateTo(Routes.InvitesDashboard);
			return;
		}
		catch (Exception exception)
		{
			errorMessage = exception.Message;
		}
		isLoaded = true;
		StateHasChanged();
		await base.OnParametersSetAsync();
	}

	/// <summary>
	/// Разбирает состояние отображения из строки запроса
	/// </summary>
	private static (bool IsFiltersView, AdrsFilter Filter) ParseViewQuery(string uri)
	{
		string? view = null;
		string? status = null;
		var query = new Uri(uri).Query.TrimStart('?');
		foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
		{
			var parts = pair.Split('=', 2);
			if (parts.Length != 2)
			{
				continue;
			}
			switch (parts[0].ToLowerInvariant())
			{
				case "view":
					view = parts[1].ToLowerInvariant();
					break;
				case "status":
					status = parts[1].ToLowerInvariant();
					break;
			}
		}

		var filter = status switch
		{
			"approved" => AdrsFilter.Approved,
			"rejected" => AdrsFilter.Rejected,
			_ => AdrsFilter.Open,
		};
		return (view == "filters", filter);
	}

	/// <summary>
	/// Строит ссылку с указанными параметрами запроса на текущем пути
	/// </summary>
	private string BuildQueryUrl(string? view, string? status)
	{
		var baseUrl = new Uri(NavigationManager.Uri).GetLeftPart(UriPartial.Path);
		var parameters = new List<string>();
		if (view != null)
		{
			parameters.Add($"view={view}");
		}
		if (status != null)
		{
			parameters.Add($"status={status}");
		}
		return parameters.Count == 0 ? baseUrl : $"{baseUrl}?{string.Join('&', parameters)}";
	}

	/// <summary>
	/// Ссылка переключения уровня 1
	/// </summary>
	private string GetViewUrl(bool toFilters)
		=> toFilters ? BuildQueryUrl("filters", null) : BuildQueryUrl(null, null);

	/// <summary>
	/// Ссылка переключения фильтра статусов
	/// </summary>
	private string GetFilterUrl(AdrsFilter filter)
		=> BuildQueryUrl("filters",
			filter switch
			{
				AdrsFilter.Approved => "approved",
				AdrsFilter.Rejected => "rejected",
				_ => "open",
			});

	/// <summary>
	/// Загружает содержимое папки: подмножество подпапок, ADR папки, хлебные крошки и счётчики
	/// </summary>
	private async Task LoadFolderDataAsync()
	{
		var organization = await ApiClient.OrganizationGetByIdAsync(OrganizationId, TokenSource.Token);
		var allFolders = (await ApiClient.AdrFolderGetByOrganizationAsync(OrganizationId, TokenSource.Token)).ToList();
		folderAdrs = FolderId == Guid.Empty
			? SortByUpdated(await ApiClient.AdrGetByOrganizationAsync(OrganizationId, TokenSource.Token))
				.Where(x => x.ParentAdrFolderId == null)
				.ToList()
			: SortByUpdated(await ApiClient.AdrGetByFolderAsync(OrganizationId, FolderId, TokenSource.Token));

		subfolders = allFolders
			.Where(x => FolderId == Guid.Empty ? x.ParentAdrFolderId == null : x.ParentAdrFolderId == FolderId)
			.OrderBy(x => x.Name.ToLower())
			.ToList();

		currentFolderCaption = FolderId == Guid.Empty
			? organization.Name
			: string.Empty;
		breadcrumbItems = [];

		if (FolderId != Guid.Empty)
		{
			var path = (await ApiClient.AdrFolderGetPathAsync(OrganizationId, FolderId, TokenSource.Token)).ToList();
			currentFolderCaption = path[^1].Name;
			breadcrumbItems =
			[
				new LinkedItem
				{
					Caption = organization.Name,
					IconType = IconTypes.Home,
					Url = string.Format(Routes.Adrs.Organization.ListFormat, OrganizationId),
				},
			];
			foreach (var folder in path.Take(path.Count - 1))
			{
				breadcrumbItems = breadcrumbItems.Append(new LinkedItem
				{
					Caption = folder.Name,
					Url = string.Format(Routes.Adrs.Organization.ListWithFolderFormat, OrganizationId, folder.Id),
				}).ToList();
			}
		}

		folderAdrCounts = [];
		var countTasks = subfolders
			.Select(async folder => (folder.Id, Count: await ApiClient.AdrFolderGetAdrCountAsync(OrganizationId, folder.Id, TokenSource.Token)))
			.ToList();
		foreach (var (folderId, count) in await Task.WhenAll(countTasks))
		{
			folderAdrCounts[folderId] = count;
		}
	}

	/// <summary>
	/// Загружает наборы ADR по фильтрам один раз для организации
	/// </summary>
	private async Task EnsureFiltersLoadedAsync()
	{
		if (filtersLoaded)
		{
			return;
		}

		var openTask = ApiClient.AdrGetByStatusesAsync(OrganizationId, [AdrStatusApi.Proposed, AdrStatusApi.NeedsRevision], TokenSource.Token);
		var approvedTask = ApiClient.AdrGetByStatusesAsync(OrganizationId, [AdrStatusApi.Approved], TokenSource.Token);
		var rejectedTask = ApiClient.AdrGetByStatusesAsync(OrganizationId, [AdrStatusApi.Rejected], TokenSource.Token);
		await Task.WhenAll(openTask, approvedTask, rejectedTask);

		openAdrs = SortByUpdated(openTask.Result);
		approvedAdrs = SortByUpdated(approvedTask.Result);
		rejectedAdrs = SortByUpdated(rejectedTask.Result);
		filtersLoaded = true;
	}

	/// <summary>
	/// Переключает уровень 1: содержимое папки или фильтры
	/// </summary>
	private async Task SwitchViewAsync(bool toFilters)
	{
		if (isFiltersView == toFilters)
		{
			return;
		}

		isFiltersView = toFilters;
		if (isFiltersView)
		{
			isLoaded = false;
			StateHasChanged();
			try
			{
				await EnsureFiltersLoadedAsync();
				errorMessage = null;
			}
			catch (Exception exception)
			{
				errorMessage = exception.Message;
			}
			isLoaded = true;
			StateHasChanged();
		}
	}

	/// <summary>
	/// Переключает уровень 2: фильтр статусов
	/// </summary>
	private void SwitchFilter(AdrsFilter filter)
	{
		activeFilter = filter;
	}

	/// <summary>
	/// Сбрасывает кэш фильтров при смене организации
	/// </summary>
	private void ResetFilters()
	{
		filtersLoaded = false;
		activeFilter = AdrsFilter.Open;
		openAdrs = null;
		approvedAdrs = null;
		rejectedAdrs = null;
	}

	private static IReadOnlyCollection<AdrApiModel> SortByUpdated(IEnumerable<AdrApiModel> items)
		=> items.OrderByDescending(x => x.UpdatedAt ?? x.CreatedAt).ToList();

	private int GetFilterCount(AdrsFilter filter)
		=> filter switch
		{
			AdrsFilter.Open => openAdrs?.Count ?? 0,
			AdrsFilter.Approved => approvedAdrs?.Count ?? 0,
			_ => rejectedAdrs?.Count ?? 0,
		};

	private int GetFolderAdrCount(Guid folderId)
		=> folderAdrCounts.TryGetValue(folderId, out var count) ? count : 0;

	private static string GetStatusCaption(AdrStatusApi status)
		=> status switch
		{
			AdrStatusApi.Draft => "Черновик",
			AdrStatusApi.Proposed => "Предложен",
			AdrStatusApi.Approved => "Одобрен",
			AdrStatusApi.Rejected => "Отклонён",
			AdrStatusApi.NeedsRevision => "Требует правок",
			_ => "Устарел",
		};

	private static ThemeColors GetStatusColor(AdrStatusApi status)
		=> status switch
		{
			AdrStatusApi.Approved => ThemeColors.Success,
			AdrStatusApi.Rejected => ThemeColors.Danger,
			AdrStatusApi.NeedsRevision => ThemeColors.Warning,
			AdrStatusApi.Proposed => ThemeColors.Info,
			AdrStatusApi.Draft => ThemeColors.Secondary,
			_ => ThemeColors.Dark,
		};
}
